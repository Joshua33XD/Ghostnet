# =============================================================================
# GhostNet IoT Intrusion Detection Rules
# Signatures for MQTT connect floods, wildcard subscribes, and authentication failures.
# =============================================================================

# 1. MQTT Connect Flood Attempt (Severity 1 / High)
# Detects rapid TCP connections carrying MQTT CONNECT packets (0x10) to broker
alert tcp any any -> any 1883 (msg:"ET GHOSTNET IoT MQTT Connect Flood Attempt"; flow:to_server,established; content:"|10|"; depth:1; threshold:type both, track by_src, count 20, seconds 5; classtype:attempted-dos; sid:1000001; rev:1;)

# 2. MQTT Wildcard Subscribe Abuse (+ or #) (Severity 2 / Medium)
# Detects SUBSCRIBE packets (0x82) containing '#' or '+' wildcards on internal topics
alert tcp any any -> any 1883 (msg:"ET GHOSTNET IoT MQTT Wildcard Subscribe Abuse (+ or #)"; flow:to_server,established; content:"|82|"; depth:1; pcre:"/[\x23\x2b]/"; classtype:policy-violation; sid:1000002; rev:1;)

# 3. Repeated MQTT Authentication Failures (Severity 2 / Medium)
# Broker CONNACK returning return code 0x04 or 0x05 (Bad User/Password or Not Authorized)
alert tcp any 1883 -> any any (msg:"ET GHOSTNET IoT MQTT Repeated Auth Failures (Bad Credentials)"; flow:to_client,established; content:"|20 02 00 04|"; threshold:type both, track by_dst, count 5, seconds 30; classtype:bad-unknown; sid:1000003; rev:1;)

# 4. IoT Service Reconnaissance Port Scan (Severity 3 / Low)
# Rapid SYN packets across common IoT service ports (MQTT, CoAP, HTTP, RTSP)
alert tcp any any -> any [1883,5683,80,554] (msg:"ET SCAN Potential IoT Reconnaissance Port Sweep"; flags:S; threshold:type threshold, track by_src, count 15, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)

# 5. Outbound Telnet / Cleartext Management Attempt (Severity 1 / High)
# Policy violation: IoT endpoints should not establish outbound Telnet sessions
alert tcp any any -> any 23 (msg:"ET POLICY IoT Insecure Telnet Connection Attempt"; flow:to_server; threshold:type limit, track by_src, count 1, seconds 60; classtype:policy-violation; sid:1000006; rev:1;)
